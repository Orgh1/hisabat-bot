# انسخ هذا الملف إلى .env واملأ القيم — لا ترفع .env لأي مستودع أبداً
TELEGRAM_BOT_TOKEN=123456789:AAAA-your-bot-token-here
# أرقام المحادثات المصرّح لها (من @userinfobot)
CHAT_ID_OWNER=
CHAT_ID_OSAMA=
CHAT_ID_ANAS=
# مفتاح Anthropic اختياري — فارغ = الصيغة المختصرة فقط (البوت يعمل عادي)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# معرّف ملف Google Sheets (الجزء بين /d/ و /edit من الرابط)
GOOGLE_SHEET_ID=
TIMEZONE=Asia/Gaza
DAILY_SUMMARY_HOUR=21
RECON_REMINDER_DAY=friday
